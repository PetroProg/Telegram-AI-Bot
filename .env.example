# Telegram Bot Settings
BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=

# Database Connection (PostgreSQL 16)
DB_HOST=news_ai_postgres
DB_PORT=5432
DB_NAME=tg_ai_bot
DB_USER=tg_ai_user
DB_PASSWORD=your_db_password_here

# LLM Providers (All Free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_HORDE_API_KEY=0000000000

# Application Settings
DEFAULT_CONTEXT_LIMIT=10
LOG_LEVEL=INFO

# Weekly Usage Report (Sunday 12:00 Europe/Zurich by default)
WEEKLY_REPORT_ENABLED=true
REPORT_CHAT_ID=
REPORT_TIMEZONE=Europe/Zurich
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=12
WEEKLY_REPORT_MINUTE=0
